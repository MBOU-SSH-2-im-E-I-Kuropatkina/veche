@
Сводный пример: все конструкции языка «Вече».
@

@
1. ЛИТЕРАЛЫ
@
пусть целое ц будет 42
пусть дробь д будет 3.14
пусть строка с будет "Привет, мир"
пусть символ сл будет "а"
пусть булево б будет истина
пусть булево б2 будет ложь
пусть ничто н будет ничто

пусть список сп будет [1; 2; 3]
пусть список сп2 будет [1; "два"; истина]
пусть словарь слв будет {"имя": "Иван"; "возраст": 18}
пусть кортеж кр будет (1; 2; 3)

@
2. ИНТЕРПОЛЯЦИЯ
@
вывод("Привет, {сл}! Число: {ц}")
вывод("Сумма: {2 + 3}")

@
3. ЭКРАНИРОВАНИЕ
@
вывод("Табуляция:\tконец")
вывод("Перенос\nстроки")
вывод("Кавычка: \"внутри\"")
вывод("Слеш: \\")

@
4. МОДИФИКАТОРЫ
@
пусть постоянное целое ПИ будет 3
пусть строгое целое строгое_число будет 5

@
5. ПРИСВАИВАНИЕ
@
пусть целое х будет 10
пусть х станет 20
пусть сп[0] станет 100
пусть слв["город"] станет "Москва"

@
6. АРИФМЕТИКА
@
пусть целое сумма будет 2 + 3
пусть целое разность будет 10 - 4
пусть целое произв будет 3 * 7
пусть дробь частное будет 10 / 3
пусть целое остаток будет 10 % 3

@
7. СРАВНЕНИЯ
@
пусть булево р1 будет (1 == 1)
пусть булево р2 будет (1 != 2)
пусть булево р3 будет (3 < 5)
пусть булево р4 будет (5 > 3)
пусть булево р5 будет (3 <= 3)
пусть булево р6 будет (3 >= 4)

@
8. ЛОГИКА
@
пусть булево л1 будет истина и ложь
пусть булево л2 будет истина или ложь
пусть булево л3 будет не истина

@
9. КОНКАТЕНАЦИЯ
@
пусть строка привет будет "Привет, " + "мир"
пусть строка с_числом будет "x = " + 5

пусть символ буква1 будет "а"
пусть символ буква2 будет "б"
пусть слово символ_символ будет буква1 + буква2
пусть строка слово_слово будет "раз" + "два"

@
10. ВЫВОД
@
вывод("Привет")
вывод(42)
вывод("а"; "б"; "в")

@
11. ВВОД
@
пусть строка введённое будет ввод("Введите что-нибудь: ")
вывод("Вы ввели: {введённое}")

@
12. УСЛОВИЯ
@
пусть целое возраст будет 18
если (возраст >= 18) то
    вывод("Взрослый")
иначе
    вывод("Ребёнок")

если (возраст < 0) то
    вывод("отрицательное")
иначе если (возраст == 0) то
    вывод("ноль")
иначе
    вывод("положительное")

@
13. ЦИКЛ ПОКА
@
пусть целое а будет 0
пока [а < 5] делать
    вывод(а)
    пусть а станет а + 1

@
14. ЦИКЛ ДЛЯ ПО КОЛЛЕКЦИИ
@
для (эл в [10; 20; 30]) делать
    вывод(эл)

для (ключ в слв) делать
    вывод(ключ)

для (буква в "Привет") делать
    вывод(буква)

@
15. ЦИКЛ ДЛЯ КЛАССИЧЕСКИЙ
@
для (пусть целое i будет 0; i < 3; пусть i станет i + 1) делать
    вывод(i)

@
16. ПРЕРВАТЬ И ПРОДОЛЖИТЬ
@
пусть целое к будет 0
пока [истина] делать
    пусть к станет к + 1
    если (к > 3) то прервать
    если (к == 2) то продолжить
    вывод("к = {к}")

@
17. ФУНКЦИИ
@
неизменяемый функция сумма(целое а; целое б) возврат целое
    возврат а + б

изменяемый функция привет_функция()
    вывод("Привет из функции!")

неизменяемый функция макс(целое а; целое б) возврат целое
    если (а > б) то
        возврат а
    возврат б

вывод(сумма(2; 3))
привет_функция()
вывод(макс(10; 7))

@
18. КЛАСС
@
класс Человек
    пустой строка имя
    пустой целое возраст

    неизменяемый функция создать(строка им; целое возр) возврат ничего
        пусть сам.имя будет им
        пусть сам.возраст будет возр

    изменяемый функция представить() возврат строка
        возврат "Меня зовут {сам.имя}, мне {сам.возраст} лет"

    изменяемый функция постареть() возврат ничего
        пусть сам.возраст станет сам.возраст + 1

пусть Человек иван будет новый Человек("Иван"; 18)
вывод(иван.представить())
иван.постареть()
вывод(иван.представить())

@
19. НАСЛЕДОВАНИЕ
@
класс Студент наследует Человек
    пустой строка группа

    неизменяемый функция создать(строка им; целое возр; строка гр) возврат ничего
        пусть сам.имя будет им
        пусть сам.возраст будет возр
        пусть сам.группа будет гр

    изменяемый функция представить() возврат строка
        возврат "Студент {сам.имя}, группа {сам.группа}"

пусть Студент петя будет новый Студент("Пётр"; 20; "ИУ7-11")
вывод(петя.представить())

@
20. ИНДЕКСАЦИЯ
@
пусть список числа будет [10; 20; 30]
вывод(числа[0])
вывод(числа[2])
пусть числа[1] станет 99
вывод(числа[1])

пусть строка текст будет "Привет"
вывод(текст[0])
вывод(текст[5])

вывод(слв["имя"])
вывод(кр[1])

@
21. ОБРАБОТКА ОШИБОК
@
попытка
    поднять ОшибкаТипа("специально возбуждённая ошибка")
перехват (Ошибка о)
    вывод("Поймали: " + о.сообщение)
    вывод("Тип: " + о.тип)
наконец
    вывод("Блок наконец выполнен")

@
22. ВСТРОЕННЫЕ ТИПЫ ОШИБОК
@
попытка
    поднять ОшибкаСинтаксиса("тест")
перехват (Ошибка о)
    вывод("ОшибкаСинтаксиса: {о.сообщение}")

попытка
    поднять ОшибкаИмени("тест")
перехват (Ошибка о)
    вывод("ОшибкаИмени: {о.сообщение}")

попытка
    поднять ОшибкаДеленияНаНоль("тест")
перехват (Ошибка о)
    вывод("ОшибкаДеленияНаНоль: {о.сообщение}")

попытка
    поднять ОшибкаИндекса("тест")
перехват (Ошибка о)
    вывод("ОшибкаИндекса: {о.сообщение}")

попытка
    поднять ОшибкаВвода("тест")
перехват (Ошибка о)
    вывод("ОшибкаВвода: {о.сообщение}")

@
23. КОМПЛЕКСНЫЙ ПРИМЕР
@
класс Точка
    пустой целое х
    пустой целое у

    неизменяемый функция создать(целое а; целое б) возврат ничего
        пусть сам.х будет а
        пусть сам.у будет б

    изменяемый функция квадрат_длины() возврат целое
        возврат сам.х * сам.х + сам.у * сам.у

    изменяемый функция представить() возврат строка
        возврат "({сам.х}, {сам.у})"

изменяемый функция сумма_квадратов(список чисел) возврат целое
    пусть целое итог будет 0
    для (эл в чисел) делать
        пусть итог станет итог + эл * эл
    возврат итог

пусть Точка т будет новый Точка(3; 4)
вывод("Точка: " + т.представить())
вывод("Квадрат длины: {т.квадрат_длины()}")

пусть список данные будет [1; 2; 3; 4]
вывод("Сумма квадратов: {сумма_квадратов(данные)}")

попытка
    пусть целое ноль будет 0
    если (ноль == 0) то
        поднять ОшибкаДеленияНаНоль("делим на ноль")
перехват (Ошибка о)
    вывод("Поймали: " + о.сообщение)

вывод("Готово.")