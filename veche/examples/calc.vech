неизменяемый функция сложение(дробь н1; дробь н2) возврат дробь
    возврат н1 + н2

неизменяемый функция вычитание(дробь н1; дробь н2) возврат дробь
    возврат н1 - н2

неизменяемый функция умножение(дробь н1; дробь н2) возврат дробь
    возврат н1 * н2

неизменяемый функция деление(дробь н1; дробь н2) возврат дробь
    если (н2 == 0) то
        поднять ОшибкаДеленияНаНоль("Деление на ноль!")
    возврат н1 / н2

неизменяемый функция степень(дробь основание; дробь степ) возврат дробь
    пусть дробь результат будет 1
    пусть целое а будет 0
    пока [а < степ] делать
        пусть результат станет результат * основание
        пусть а станет а + 1
    возврат результат

неизменяемый функция главный() возврат ничего
    пока [истина] делать
        пусть символ операция будет ""
        пусть дробь число1 будет 0
        пусть дробь число2 будет 0

        пусть число1 станет дробь(ввод("Введите число 1: "))
        пусть операция станет символ(ввод("Введите операцию: "))
        пусть число2 станет дробь(ввод("Введите число 2: "))

        если (операция == "+") то
            вывод("Результат: {сложение(число1; число2)}")
        иначе если (операция == "-") то
            вывод("Результат: {вычитание(число1; число2)}")
        иначе если (операция == "*") то
            вывод("Результат: {умножение(число1; число2)}")
        иначе если (операция == "/") то
            попытка
                вывод("Результат: {деление(число1; число2)}")
            перехват (Ошибка о)
                вывод("Ошибка: {о.сообщение}")
        иначе если (операция == "^") то
            вывод("Результат: {степень(число1; число2)}")
        иначе
            вывод("Неизвестный режим: {операция}")

главный()