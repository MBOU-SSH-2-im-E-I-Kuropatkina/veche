{
  "Если": {
    "prefix": "если",
    "body": [
      "если (${1:условие}) {",
      "\t$0",
      "}"
    ],
    "description": "Условный оператор если"
  },
  "Если-Иначе": {
    "prefix": "еслииначе",
    "body": [
      "если (${1:условие}) {",
      "\t$2",
      "} иначе {",
      "\t$0",
      "}"
    ],
    "description": "Если / иначе"
  },
  "Пока": {
    "prefix": "пока",
    "body": [
      "пока (${1:условие}) {",
      "\t$0",
      "}"
    ],
    "description": "Цикл пока"
  },
  "Для-в": {
    "prefix": "дляв",
    "body": [
      "для (${1:перем} в ${2:коллекция}) {",
      "\t$0",
      "}"
    ],
    "description": "Цикл для ... в ..."
  },
  "Для-классический": {
    "prefix": "для",
    "body": [
      "для (целое ${1:и} = 0; ${1:и} < ${2:н}; ${1:и} = ${1:и} + 1) {",
      "\t$0",
      "}"
    ],
    "description": "Классический цикл для"
  },
  "Функция": {
    "prefix": "функция",
    "body": [
      "функция ${1:имя}(${2:целое а}) -> ${3:целое} {",
      "\tвозврат ${0:а}",
      "}"
    ],
    "description": "Объявление функции"
  },
  "Класс": {
    "prefix": "класс",
    "body": [
      "класс ${1:Имя} {",
      "\t${2:строка} ${3:поле}",
      "",
      "\tфункция создать(${4:строка и}) {",
      "\t\tсебя.${3:поле} = ${4:и}",
      "\t}",
      "",
      "\tфункция ${5:метод}() {",
      "\t\tвозврат ${0:себя.${3:поле}}",
      "\t}",
      "}"
    ],
    "description": "Объявление класса"
  },
  "Попытка-Перехват": {
    "prefix": "попытка",
    "body": [
      "попытка {",
      "\t$1",
      "} перехват (Ошибка ${2:о}) {",
      "\tпечать(\"Ошибка: \" + ${2:о}.сообщение)",
      "} наконец {",
      "\t$0",
      "}"
    ],
    "description": "Обработка ошибок"
  },
  "Печать": {
    "prefix": "печать",
    "body": ["печать(${1:значение})"],
    "description": "Вывод"
  },
  "Ввод": {
    "prefix": "ввод",
    "body": ["ввод(\"${1:Подсказка: }\")"],
    "description": "Ввод строки"
  },
  "Переменная: целое": {
    "prefix": "целое",
    "body": ["целое ${1:имя} = ${0:0}"],
    "description": "Объявление целого"
  },
  "Переменная: строка": {
    "prefix": "строка",
    "body": ["строка ${1:имя} = \"${0:значение}\""],
    "description": "Объявление строки"
  },
  "Переменная: слово": {
    "prefix": "слово",
    "body": ["слово ${1:имя} = \"${0:значение}\""],
    "description": "Объявление слова (без пробелов, - и _)"
  },
  "Переменная: булево": {
    "prefix": "булево",
    "body": ["булево ${1:имя} = ${0:истина}"],
    "description": "Объявление булева"
  },
  "Переменная: дробное": {
    "prefix": "дробное",
    "body": ["дробное ${1:имя} = ${0:0.0}"],
    "description": "Объявление дробного"
  },
  "Список": {
    "prefix": "список",
    "body": ["список ${1:имя} = [${0}]"],
    "description": "Объявление списка"
  },
  "Словарь": {
    "prefix": "словарь",
    "body": ["словарь ${1:имя} = {\"${2:ключ}\": ${0:значение}}"],
    "description": "Объявление словаря"
  },
  "Поднять": {
    "prefix": "поднять",
    "body": ["поднять ${1:ОшибкаТипа}(\"${0:сообщение}\")"],
    "description": "Возбудить ошибку"
  }
}