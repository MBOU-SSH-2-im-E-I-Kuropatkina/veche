@
Пример: графика.
Рисует линии, прямоугольник и точку. Ждёт 3 секунды и закрывает окно.
@

окно(640; 480; "Вече — рисование")

цвет(255; 0; 0)
рисовать_линию(0; 0; 640; 480)
рисовать_линию(640; 0; 0; 480)

цвет(0; 255; 0)
рисовать_прямоугольник(100; 100; 200; 150)

цвет(0; 0; 255)
рисовать_точку(320; 240)

пауза(3000)
закрыть_окно()