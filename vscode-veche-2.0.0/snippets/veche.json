{
  "Переменная с типом": {
    "prefix": "пусть",
    "body": ["пусть ${1:целое} ${2:имя} будет ${0:значение}"],
    "description": "Объявление переменной"
  },
  "Присваивание": {
    "prefix": "станет",
    "body": ["пусть ${1:имя} станет ${0:значение}"],
    "description": "Присваивание существующей переменной"
  },
  "Константа": {
    "prefix": "постоянное",
    "body": ["пусть постоянное ${1:целое} ${2:ИМЯ} будет ${0:значение}"],
    "description": "Объявление константы"
  },
  "Строгий тип": {
    "prefix": "строгое",
    "body": ["пусть строгое ${1:целое} ${2:имя} будет ${0:значение}"],
    "description": "Объявление со строгой типизацией"
  },
  "Если": {
    "prefix": "если",
    "body": [
      "если (${1:условие}) то",
      "\t$0"
    ],
    "description": "Условный оператор если"
  },
  "Если-Иначе": {
    "prefix": "еслииначе",
    "body": [
      "если (${1:условие}) то",
      "\t$2",
      "иначе",
      "\t$0"
    ],
    "description": "Если / иначе"
  },
  "Если-ИначеЕсли-Иначе": {
    "prefix": "если3",
    "body": [
      "если (${1:условие1}) то",
      "\t$2",
      "иначе если (${3:условие2}) то",
      "\t$4",
      "иначе",
      "\t$0"
    ],
    "description": "Полное ветвление"
  },
  "Пока": {
    "prefix": "пока",
    "body": [
      "пока [${1:условие}] делать",
      "\t$0"
    ],
    "description": "Цикл пока"
  },
  "Для по коллекции": {
    "prefix": "дляв",
    "body": [
      "для (${1:элемент} в ${2:коллекция}) делать",
      "\t$0"
    ],
    "description": "Цикл для … в …"
  },
  "Для классический": {
    "prefix": "для",
    "body": [
      "для (пусть целое ${1:i} будет 0; ${1:i} < ${2:n}; пусть ${1:i} станет ${1:i} + 1) делать",
      "\t$0"
    ],
    "description": "Классический цикл для"
  },
  "Функция неизменяемая": {
    "prefix": "функция",
    "body": [
      "неизменяемый функция ${1:имя}(${2:целое а}) возврат ${3:целое}",
      "\tвозврат ${0:а}"
    ],
    "description": "Неизменяемая функция"
  },
  "Функция изменяемая": {
    "prefix": "изменяемый",
    "body": [
      "изменяемый функция ${1:имя}(${2:целое а}) возврат ${3:целое}",
      "\tвозврат ${0:а}"
    ],
    "description": "Изменяемая функция"
  },
  "Класс": {
    "prefix": "класс",
    "body": [
      "класс ${1:Имя}",
      "\tпустой ${2:строка} ${3:поле}",
      "",
      "\tнеизменяемый функция создать(${4:строка и}) возврат ничего",
      "\t\tпусть сам.${3:поле} будет ${4:и}",
      "",
      "\tизменяемый функция ${5:метод}() возврат ${6:строка}",
      "\t\tвозврат ${0:сам.${3:поле}}"
    ],
    "description": "Объявление класса"
  },
  "Класс с наследованием": {
    "prefix": "наследует",
    "body": [
      "класс ${1:Имя} наследует ${2:Базовый}",
      "\tпустой ${3:строка} ${4:поле}",
      "",
      "\tнеизменяемый функция создать(${5:строка и}) возврат ничего",
      "\t\tпусть сам.${4:поле} будет ${5:и}",
      "",
      "\tизменяемый функция ${6:метод}() возврат ${7:строка}",
      "\t\tвозврат ${0:\"…\"}"
    ],
    "description": "Класс с наследованием"
  },
  "Попытка-Перехват-Наконец": {
    "prefix": "попытка",
    "body": [
      "попытка",
      "\t$1",
      "перехват (Ошибка ${2:о})",
      "\tвывод(\"Ошибка: \" + ${2:о}.сообщение)",
      "наконец",
      "\t$0"
    ],
    "description": "Обработка ошибок"
  },
  "Вывод": {
    "prefix": "вывод",
    "body": ["вывод(${1:значение})"],
    "description": "Вывод значения"
  },
  "Ввод": {
    "prefix": "ввод",
    "body": ["ввод(\"${1:Подсказка: }\")"],
    "description": "Ввод строки"
  },
  "Список": {
    "prefix": "список",
    "body": ["пусть список ${1:имя} будет [${0}]"],
    "description": "Объявление списка"
  },
  "Словарь": {
    "prefix": "словарь",
    "body": ["пусть словарь ${1:имя} будет {\"${2:ключ}\": ${0:значение}}"],
    "description": "Объявление словаря"
  },
  "Поднять ошибку": {
    "prefix": "поднять",
    "body": ["поднять ${1:ОшибкаТипа}(\"${0:сообщение}\")"],
    "description": "Возбудить ошибку"
  },
  "Окно": {
    "prefix": "окно",
    "body": ["окно(${1:640}; ${2:480}; \"${3:Вече}\")"],
    "description": "Создать графическое окно"
  },
  "Линия": {
    "prefix": "линия",
    "body": ["рисовать_линию(${1:0}; ${2:0}; ${3:100}; ${4:100})"],
    "description": "Нарисовать линию"
  },
  "Прямоугольник": {
    "prefix": "прямоугольник",
    "body": ["рисовать_прямоугольник(${1:0}; ${2:0}; ${3:100}; ${4:100})"],
    "description": "Нарисовать прямоугольник"
  },
  "Точка": {
    "prefix": "точка",
    "body": ["рисовать_точку(${1:0}; ${2:0})"],
    "description": "Нарисовать точку"
  }
}