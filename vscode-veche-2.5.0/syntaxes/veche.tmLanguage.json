{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Вече",
  "scopeName": "source.veche",
  "fileTypes": [".veche", ".vech"],
  "patterns": [
    { "include": "#blockComment" },
    { "include": "#lineComment" },
    { "include": "#strings" },
    { "include": "#interpolation" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#graphics" },
    { "include": "#builtins" },
    { "include": "#errors" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#variables" }
  ],
  "repository": {

    "blockComment": {
      "patterns": [
        {
          "name": "comment.block.veche",
          "begin": "^\\s*@\\s*$",
          "end": "^\\s*@\\s*$"
        },
        {
          "name": "comment.line.at.veche",
          "match": "^\\s*@.*$"
        }
      ]
    },

    "lineComment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.veche",
          "match": "//.*$"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.veche",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#interpolation" },
            {
              "name": "constant.character.escape.veche",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.expression.veche",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#numbers" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#constants" },
            { "include": "#variables" },
            { "include": "#operators" }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.veche",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.veche",
          "match": "\\b\\d+\\b"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.veche",
          "match": "\\b(если|иначе|то|пока|для|в|делать|прервать|продолжить|возврат|попытка|перехват|наконец|поднять)\\b"
        },
        {
          "name": "keyword.declaration.veche",
          "match": "\\b(функция|класс|наследует|переопределить|неизменяемый|изменяемый|пусть|будет|станет|постоянное|строгое|пустой)\\b"
        },
        {
          "name": "keyword.other.veche",
          "match": "\\b(новый|создать|сам|базовый)\\b"
        },
        {
          "name": "keyword.operator.word.veche",
          "match": "\\b(и|или|не)\\b"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "storage.type.veche",
          "match": "\\b(целое|дробь|строка|символ|слово|булево|список|словарь|кортеж|ничто|ничего)\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.veche",
          "match": "\\b(истина|ложь)\\b"
        },
        {
          "name": "constant.language.null.veche",
          "match": "\\b(ничто|ничего)\\b"
        }
      ]
    },

    "graphics": {
      "patterns": [
        {
          "name": "support.function.graphics.veche",
          "match": "\\b(окно|рисовать_точку|рисовать_линию|рисовать_прямоугольник|цвет|очистить|пауза|закрыть_окно)\\b"
        }
      ]
    },

    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.veche",
          "match": "\\b(вывод|ввод)\\b"
        }
      ]
    },

    "errors": {
      "patterns": [
        {
          "name": "support.class.error.veche",
          "match": "\\b(ОшибкаСинтаксиса|ОшибкаТипа|ОшибкаИмени|ОшибкаДеленияНаНоль|ОшибкаИндекса|ОшибкаВвода|Ошибка)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.veche",
          "match": "==|!=|<=|>=|->|[+\\-*/%<>=!]"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.veche",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.definition.veche",
          "match": "[\\[\\](){}]"
        },
        {
          "name": "punctuation.accessor.veche",
          "match": "\\."
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.veche",
          "match": "(?<=\\bфункция\\s+)[\\p{L}_][\\p{L}\\p{N}_]*"
        },
        {
          "name": "entity.name.function.call.veche",
          "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
        }
      ]
    },

    "classes": {
      "patterns": [
        {
          "name": "entity.name.type.class.veche",
          "match": "(?<=\\bкласс\\s+)[\\p{L}_][\\p{L}\\p{N}_]*"
        },
        {
          "name": "entity.other.inherited-class.veche",
          "match": "(?<=\\bнаследует\\s+)[\\p{L}_][\\p{L}\\p{N}_]*"
        }
      ]
    },

    "variables": {
      "patterns": [
        {
          "name": "variable.other.veche",
          "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*\\b"
        }
      ]
    }

  }
}